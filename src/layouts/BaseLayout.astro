---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
// Self-hosted copies of the exact variable font files Google Fonts served
// (latin subset only). Each face below mirrors one of Google's fixed-weight
// declarations so rendering is unchanged; unused faces are left out.
import cormorantNormal from '@fontsource-variable/cormorant-garamond/files/cormorant-garamond-latin-wght-normal.woff2?url';
import cormorantItalic from '@fontsource-variable/cormorant-garamond/files/cormorant-garamond-latin-wght-italic.woff2?url';
import dmSansNormal from '@fontsource-variable/dm-sans/files/dm-sans-latin-opsz-normal.woff2?url';

const latinRange =
  'U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD';
const fontFaces: [family: string, style: string, weight: number, src: string][] = [
  ['Cormorant Garamond', 'normal', 300, cormorantNormal],
  ['Cormorant Garamond', 'normal', 400, cormorantNormal],
  ['Cormorant Garamond', 'normal', 600, cormorantNormal],
  ['Cormorant Garamond', 'italic', 400, cormorantItalic],
  ['DM Sans', 'normal', 300, dmSansNormal],
  ['DM Sans', 'normal', 400, dmSansNormal],
  ['DM Sans', 'normal', 500, dmSansNormal],
];
const fontFaceCss = fontFaces
  .map(
    ([family, style, weight, src]) =>
      `@font-face{font-family:'${family}';font-style:${style};font-weight:${weight};font-display:swap;src:url(${src}) format('woff2');unicode-range:${latinRange}}`
  )
  .join('');

interface Props {
  title: string;
  description?: string;
  solidNav?: boolean;
}

const {
  title,
  description = 'Award-winning piano instruction and music production in Stittsville, Ottawa.',
  solidNav = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/dt-white.png" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <!-- Preload only the two faces used by the hero heading, nav and body copy -->
    <link rel="preload" href={dmSansNormal} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={cormorantNormal} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFaceCss}></style>
    {Astro.site && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />}
    {
      import.meta.env.PROD && (
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          gtag('js', new Date());
          gtag('config', 'G-3NPXK39CYT');

          // Commands above are queued in dataLayer; gtag.js replays them (including
          // the page view) when it loads. Defer that download until after the page
          // has loaded and the main thread is idle so it doesn't compete with first
          // render.
          function loadGtag() {
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=G-3NPXK39CYT';
            document.head.appendChild(s);
          }
          function scheduleGtag() {
            if ('requestIdleCallback' in window) {
              requestIdleCallback(loadGtag, { timeout: 3000 });
            } else {
              setTimeout(loadGtag, 1);
            }
          }
          if (document.readyState === 'complete') {
            scheduleGtag();
          } else {
            window.addEventListener('load', scheduleGtag, { once: true });
          }
        </script>
      )
    }
  </head>
  <body>
    <Nav solidNav={solidNav} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
